---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  entryKey,
  entryLanguage,
  isPublished,
  pagePath,
  type Language,
} from '../../i18n';

export async function getStaticPaths() {
  // Slugs already taken by built-in routes; a page with one of these
  // translation keys would shadow them, so it is skipped.
  const reserved = new Set(['events']);

  const pages = await getCollection(
    'pages',
    (entry) => isPublished(entry.data) && !reserved.has(entryKey(entry.id)),
  );

  return pages.map((entry) => {
    const key = entryKey(entry.id);
    const alternates = Object.fromEntries(
      pages
        .filter((p) => entryKey(p.id) === key)
        .map((p) => [entryLanguage(p.id), pagePath(entryLanguage(p.id), key)]),
    ) as Partial<Record<Language, string>>;

    return {
      params: { lang: entryLanguage(entry.id), slug: key },
      props: { entry, alternates },
    };
  });
}

const { entry, alternates } = Astro.props;
const lang = entryLanguage(entry.id);
const { title, description } = entry.data;

const { Content } = await render(entry);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description ?? title}
  alternates={alternates}
>
  <article>
    <h1 class="decorated">{title}</h1>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
