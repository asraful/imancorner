---
import { getCollection, render } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  entryKey,
  entryLanguage,
  isPublished,
  pagePath,
  type Language,
} from '../../i18n';
import { getSettings } from '../../lib/site';

export async function getStaticPaths() {
  // Slugs already taken by built-in routes; a page with one of these
  // translation keys would shadow them, so it is skipped.
  const reserved = new Set(['events', 'articles', 'series', 'topics']);

  const pages = await getCollection(
    'pages',
    (entry) => isPublished(entry.data) && !reserved.has(entryKey(entry.id)),
  );

  return pages.map((entry) => {
    const key = entryKey(entry.id);
    const alternates = Object.fromEntries(
      pages
        .filter((p) => entryKey(p.id) === key)
        .map((p) => [entryLanguage(p.id), pagePath(entryLanguage(p.id), key)]),
    ) as Partial<Record<Language, string>>;

    return {
      params: { lang: entryLanguage(entry.id), slug: key },
      props: { entry, alternates },
    };
  });
}

const { entry, alternates } = Astro.props;
const lang = entryLanguage(entry.id);
const { title, description } = entry.data;

const { data: settings } = await getSettings(lang);
const { Content } = await render(entry);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description ?? title}
  alternates={alternates}
>
  <PageHeader eyebrow={settings.siteName} title={title} intro={description} />

  <div class="mx-auto max-w-6xl px-5 py-16">
    <article class="prose">
      <Content />
    </article>
  </div>
</BaseLayout>
