---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  entryKey,
  entryLanguage,
  eventPath,
  formatDate,
  t,
  type Language,
} from '../../../i18n';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.isDraft);

  return events.map((entry) => {
    const key = entryKey(entry.id);
    const alternates = Object.fromEntries(
      events
        .filter((e) => entryKey(e.id) === key)
        .map((e) => [entryLanguage(e.id), eventPath(entryLanguage(e.id), key)]),
    ) as Partial<Record<Language, string>>;

    return {
      params: { lang: entryLanguage(entry.id), slug: key },
      props: { entry, alternates },
    };
  });
}

/**
 * YouTube only allows /embed/ URLs inside iframes (X-Frame-Options: sameorigin
 * on all other pages), but CMS editors will paste whatever is in their address
 * bar — watch, youtu.be, or shorts links. Normalize them all to the embed form.
 */
function toEmbedUrl(url: string): string {
  const match = url.match(
    /^https?:\/\/(?:www\.|m\.)?(?:youtube\.com\/(?:watch\?.*?v=|shorts\/|live\/)|youtu\.be\/)([\w-]{11})/,
  );

  if (!match) return url;

  const start = url.match(/[?&](?:t|start)=(\d+)/)?.[1];
  return `https://www.youtube.com/embed/${match[1]}${start ? `?start=${start}` : ''}`;
}

const { entry, alternates } = Astro.props;
const lang = entryLanguage(entry.id);
const { title, eventDate, location, tags, videoUrl } = entry.data;

const { Content } = await render(entry);

const dateFormatted = formatDate(eventDate, lang);
const description = `${title} — ${dateFormatted}, ${location}`;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternates={alternates}
>
  <article>
    <h1 class="decorated">{title}</h1>

    <dl class="event-detail-meta">
      <dt>{t(lang, 'event.date')}</dt>
      <dd>
        <time datetime={eventDate.toISOString().slice(0, 10)}>
          {dateFormatted}
        </time>
      </dd>
      <dt>{t(lang, 'event.location')}</dt>
      <dd>{location}</dd>
    </dl>

    {
      tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }

    {
      videoUrl && (
        <div class="video-wrapper">
          <iframe
            src={toEmbedUrl(videoUrl)}
            title={`${t(lang, 'event.video')}: ${title}`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  <a class="back-link" href={`/${lang}/events/`}>
    {t(lang, 'event.backToEvents')}
  </a>
</BaseLayout>
