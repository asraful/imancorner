---
import EventCard from '../../../components/EventCard.astro';
import Icon from '../../../components/Icon.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  entryKey,
  eventPath,
  formatDate,
  languageCodes,
  t,
  type Language,
} from '../../../i18n';
import {
  getPastEvents,
  getSettings,
  getUpcomingEvents,
  type EventEntry,
} from '../../../lib/site';
import type { EventListItem } from '../../../scripts/alpine';

export function getStaticPaths() {
  return languageCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;

const alternates = Object.fromEntries(
  languageCodes.map((code) => [code, `/${code}/events/`]),
);

const { data: settings } = await getSettings(lang);
const events = await getUpcomingEvents(lang);
const pastEvents = await getPastEvents(lang);

function toListItem(event: EventEntry): EventListItem {
  const dateFormatted = formatDate(event.data.eventDate, lang);

  return {
    title: event.data.title,
    url: eventPath(lang, entryKey(event.id)),
    location: event.data.location,
    category: event.data.category,
    time: event.data.time,
    tags: event.data.tags,
    dateISO: event.data.eventDate.toISOString().slice(0, 10),
    dateFormatted,
    when: event.data.time ? `${dateFormatted} · ${event.data.time}` : dateFormatted,
  };
}

const items = events.map(toListItem);
const pastItems = pastEvents.map(toListItem);

const allTags = [...new Set(events.flatMap((event) => event.data.tags))].sort();

// <-escape so the JSON can never close its own <script> tag
const itemsJson = JSON.stringify(items).replace(/</g, '\\u003c');
---

<BaseLayout
  lang={lang}
  title={t(lang, 'events.heading')}
  description={settings.tagline || t(lang, 'site.tagline')}
  alternates={alternates}
>
  <PageHeader eyebrow={settings.siteName} title={t(lang, 'events.heading')} />

  <div class="mx-auto max-w-6xl px-5 py-16">
    {
      items.length === 0 && pastItems.length === 0 ? (
        <p class="text-muted-foreground">{t(lang, 'events.none')}</p>
      ) : (
        <>
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <h2 class="text-3xl sm:text-4xl">{t(lang, 'events.upcoming')}</h2>
          <div class="h-[2px] w-32 rule-gold" aria-hidden="true"></div>
        </div>
        {items.length === 0 ? (
          <p class="rounded-lg border border-border bg-card p-6 text-muted-foreground shadow-soft">
            {t(lang, 'events.noneUpcoming')}
          </p>
        ) : (
        <section x-data="eventList">
          <form
            class="flex flex-wrap items-center gap-3"
            role="search"
            x-on:submit.prevent=""
          >
            <label class="sr-only" for="event-search">
              {t(lang, 'events.searchLabel')}
            </label>
            <div class="relative flex-1 sm:max-w-sm">
              <span class="pointer-events-none absolute inset-y-0 start-3 flex items-center text-muted-foreground">
                <Icon name="search" class="h-4 w-4" />
              </span>
              <input
                type="search"
                id="event-search"
                x-model="search"
                placeholder={t(lang, 'events.searchPlaceholder')}
                class="w-full rounded-md border border-border bg-card py-2.5 ps-10 pe-3 text-sm shadow-soft focus:outline-none focus:ring-2 focus:ring-gold"
              />
            </div>
            <button
              type="button"
              class="rounded-md border border-border bg-card px-3 py-2 text-sm text-muted-foreground transition-colors hover:border-gold/50 hover:text-primary"
              x-show="hasFilters"
              x-cloak
              x-on:click="reset()"
            >
              {t(lang, 'events.reset')}
            </button>
          </form>

          {allTags.length > 0 && (
            <div
              class="mt-4 flex flex-wrap gap-2"
              role="group"
              aria-label={t(lang, 'events.filterByTag')}
            >
              {allTags.map((tag) => (
                <button
                  type="button"
                  aria-pressed="false"
                  x-on:click={`toggleTag(${JSON.stringify(tag)})`}
                  x-bind:aria-pressed={`(activeTag === ${JSON.stringify(tag)}).toString()`}
                  x-bind:class={`activeTag === ${JSON.stringify(tag)} ? 'bg-emerald-gradient text-primary-foreground border-transparent' : 'bg-card text-muted-foreground border-border hover:border-gold/50'`}
                  class="rounded-full border px-3 py-1 text-xs font-medium transition-colors"
                >
                  {tag}
                </button>
              ))}
            </div>
          )}

          <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            <template x-for="event in filteredEvents" x-bind:key="event.url">
              <article class="flex flex-col rounded-lg border border-border bg-card p-6 shadow-soft transition-all hover:-translate-y-1 hover:border-gold/50 hover:shadow-lift">
                <div class="flex items-center justify-between gap-3">
                  <span
                    class="rounded-full bg-accent px-3 py-1 text-xs font-medium text-accent-foreground"
                    x-show="event.category"
                    x-text="event.category"
                  />
                  <span class="ms-auto flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                    <Icon name="calendar" class="h-4 w-4" />
                  </span>
                </div>

                <h3 class="mt-5 text-xl leading-snug">
                  <a
                    class="transition-colors hover:text-primary"
                    x-bind:href="event.url"
                    x-text="event.title"
                  />
                </h3>

                <div class="mt-4 space-y-2 text-sm text-muted-foreground">
                  <p class="flex items-center gap-2">
                    <Icon name="clock" class="h-4 w-4 shrink-0 text-gold" />
                    <time x-bind:datetime="event.dateISO" x-text="event.when" />
                  </p>
                  <p class="flex items-center gap-2" x-show="event.location">
                    <Icon name="map-pin" class="h-4 w-4 shrink-0 text-gold" />
                    <span x-text="event.location" />
                  </p>
                </div>

                <ul class="mt-4 flex flex-wrap gap-2">
                  <template x-for="tag in event.tags" x-bind:key="tag">
                    <li
                      class="rounded-full bg-secondary px-2.5 py-0.5 text-xs text-secondary-foreground"
                      x-text="tag"
                    />
                  </template>
                </ul>

                <a
                  class="mt-6 inline-flex w-full items-center justify-center rounded-md border border-border bg-secondary py-2.5 text-sm font-medium text-secondary-foreground transition-colors hover:border-gold/50 hover:bg-accent"
                  x-bind:href="event.url"
                >
                  {t(lang, 'event.details')}
                </a>
              </article>
            </template>
          </div>

          <p
            class="py-8 text-muted-foreground"
            x-show="filteredEvents.length === 0"
            x-cloak
            aria-live="polite"
          >
            {t(lang, 'events.noResults')}
          </p>

          <noscript>
            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {items.map((item) => (
                <EventCard {...item} ctaLabel={t(lang, 'event.details')} />
              ))}
            </div>
          </noscript>

          <script
            type="application/json"
            id="event-data"
            set:html={itemsJson}
            is:inline
          />
        </section>
        )}

        {pastItems.length > 0 && (
          <section id="past" class="mt-20 scroll-mt-24">
            <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
              <h2 class="text-3xl sm:text-4xl">{t(lang, 'events.past')}</h2>
              <div class="h-[2px] w-32 rule-gold" aria-hidden="true"></div>
            </div>
            <div class="grid gap-5 opacity-90 md:grid-cols-2 lg:grid-cols-3">
              {pastItems.map((item) => (
                <EventCard {...item} ctaLabel={t(lang, 'event.details')} />
              ))}
            </div>
          </section>
        )}
        </>
      )
    }
  </div>
</BaseLayout>
