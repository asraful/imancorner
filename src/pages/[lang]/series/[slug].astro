---
import { getCollection, render } from 'astro:content';
import Icon from '../../../components/Icon.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  entryKey,
  entryLanguage,
  isPublished,
  seriesPath,
  t,
  type Language,
} from '../../../i18n';

export async function getStaticPaths() {
  const series = await getCollection('series', ({ data }) => isPublished(data));

  return series.map((entry) => {
    const key = entryKey(entry.id);
    const alternates = Object.fromEntries(
      series
        .filter((s) => entryKey(s.id) === key)
        .map((s) => [entryLanguage(s.id), seriesPath(entryLanguage(s.id), key)]),
    ) as Partial<Record<Language, string>>;

    return {
      params: { lang: entryLanguage(entry.id), slug: key },
      props: { entry, alternates },
    };
  });
}

const { entry, alternates } = Astro.props;
const lang = entryLanguage(entry.id);
const { title, description, partsLabel } = entry.data;

const { Content } = await render(entry);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description || title}
  alternates={alternates}
>
  <PageHeader
    eyebrow={partsLabel || t(lang, 'series.heading')}
    title={title}
    intro={description}
  />

  <div class="mx-auto max-w-6xl px-5 py-16">
    <article class="prose">
      <Content />
    </article>

    <a
      href={`/${lang}/series/`}
      class="mt-10 inline-flex items-center gap-2 text-sm font-medium text-primary"
    >
      <Icon name="arrow-right" class="h-4 w-4 -scale-x-100 rtl:scale-x-100" />
      {t(lang, 'series.backToSeries')}
    </a>
  </div>
</BaseLayout>
