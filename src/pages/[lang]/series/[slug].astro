---
import { getCollection, render } from 'astro:content';
import Icon from '../../../components/Icon.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  articlePath,
  entryKey,
  entryLanguage,
  isPublished,
  seriesPath,
  t,
  type Language,
} from '../../../i18n';
import { getSeriesParts } from '../../../lib/site';

export async function getStaticPaths() {
  const series = await getCollection('series', ({ data }) => isPublished(data));

  return series.map((entry) => {
    const key = entryKey(entry.id);
    const alternates = Object.fromEntries(
      series
        .filter((s) => entryKey(s.id) === key)
        .map((s) => [entryLanguage(s.id), seriesPath(entryLanguage(s.id), key)]),
    ) as Partial<Record<Language, string>>;

    return {
      params: { lang: entryLanguage(entry.id), slug: key },
      props: { entry, alternates },
    };
  });
}

const { entry, alternates } = Astro.props;
const lang = entryLanguage(entry.id);
const { title, description, partsLabel } = entry.data;

const { Content } = await render(entry);

const parts = await getSeriesParts(lang, entryKey(entry.id));
---

<BaseLayout
  lang={lang}
  title={title}
  description={description || title}
  alternates={alternates}
  searchable
>
  <PageHeader
    eyebrow={partsLabel || t(lang, 'series.heading')}
    title={title}
    intro={description}
  />

  <div class="mx-auto max-w-6xl px-5 py-16">
    <article class="prose">
      <Content />
    </article>

    <section class="mt-14">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl sm:text-4xl">{t(lang, 'series.parts')}</h2>
        <div class="h-[2px] w-32 rule-gold" aria-hidden="true"></div>
      </div>

      {
        parts.length === 0 ? (
          <p class="mt-8 text-muted-foreground">{t(lang, 'series.noParts')}</p>
        ) : (
          <ol class="mt-8 divide-y divide-border overflow-hidden rounded-lg border border-border bg-card shadow-soft">
            {parts.map((part, index) => (
              <li>
                <a
                  href={articlePath(lang, entryKey(part.id))}
                  class="group flex items-start gap-5 p-5 transition-colors hover:bg-secondary/60"
                >
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 font-display text-lg text-primary">
                    {part.data.seriesPart ?? index + 1}
                  </span>
                  <span class="flex-1">
                    <span class="block text-lg leading-snug transition-colors group-hover:text-primary">
                      {part.data.title}
                    </span>
                    {part.data.excerpt && (
                      <span class="mt-1 block text-sm text-muted-foreground">
                        {part.data.excerpt}
                      </span>
                    )}
                  </span>
                  <Icon
                    name="arrow-right"
                    class="mt-3 h-4 w-4 shrink-0 text-gold rtl:-scale-x-100"
                  />
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </section>

    <a
      href={`/${lang}/series/`}
      class="mt-10 inline-flex items-center gap-2 text-sm font-medium text-primary"
    >
      <Icon name="arrow-right" class="h-4 w-4 -scale-x-100 rtl:scale-x-100" />
      {t(lang, 'series.backToSeries')}
    </a>
  </div>
</BaseLayout>
