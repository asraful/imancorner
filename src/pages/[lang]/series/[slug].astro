---
import { getCollection, render } from 'astro:content';
import Icon from '../../../components/Icon.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  articlePath,
  entryKey,
  entryLanguage,
  formatDate,
  formatDuration,
  isPublished,
  seriesPath,
  t,
  videoCount,
  type Language,
} from '../../../i18n';
import { toEmbedUrl, youtubeId, youtubeThumbnail } from '../../../lib/youtube';
import { getSeriesParts, getTopics, seriesMinutes } from '../../../lib/site';

export async function getStaticPaths() {
  const series = await getCollection('series', ({ data }) => isPublished(data));

  return series.map((entry) => {
    const key = entryKey(entry.id);
    const alternates = Object.fromEntries(
      series
        .filter((s) => entryKey(s.id) === key)
        .map((s) => [entryLanguage(s.id), seriesPath(entryLanguage(s.id), key)]),
    ) as Partial<Record<Language, string>>;

    return {
      params: { lang: entryLanguage(entry.id), slug: key },
      props: { entry, alternates },
    };
  });
}

const { entry, alternates } = Astro.props;
const lang = entryLanguage(entry.id);
const { title, description, partsLabel, videos, playlistUrl, topic } = entry.data;

const { Content } = await render(entry);

const parts = await getSeriesParts(lang, entryKey(entry.id));

const lessons = videos.map((video) => ({
  ...video,
  embedUrl: toEmbedUrl(video.url),
  id: youtubeId(video.url)!,
}));
const firstLesson = lessons[0];

const languageKeys = {
  en: 'video.lang.en',
  ar: 'video.lang.ar',
  both: 'video.lang.both',
} as const;

const metaLine = (lesson: (typeof lessons)[number]) =>
  [
    t(lang, languageKeys[lesson.language]),
    lesson.minutes > 0 && formatDuration(lang, lesson.minutes),
    lesson.date && formatDate(lesson.date, lang),
  ]
    .filter(Boolean)
    .join(' · ');

// Read by the videoPlaylist component (src/scripts/alpine.ts).
const playlistJson = JSON.stringify(
  lessons.map((lesson) => ({
    id: lesson.id,
    embed: lesson.embedUrl,
    title: lesson.title,
    meta: metaLine(lesson),
  })),
);

const topicEntry = (await getTopics(lang)).find((item) => entryKey(item.id) === topic);
const totalMinutes = seriesMinutes(entry);
const eyebrow = [
  partsLabel || (lessons.length > 0 ? videoCount(lang, lessons.length) : t(lang, 'series.heading')),
  totalMinutes > 0 && formatDuration(lang, totalMinutes),
  topicEntry?.data.title,
]
  .filter(Boolean)
  .join(' · ');
---

<BaseLayout
  lang={lang}
  title={title}
  description={description || title}
  alternates={alternates}
  searchable
  image={firstLesson && youtubeThumbnail(firstLesson.id)}
>
  <PageHeader eyebrow={eyebrow} title={title} intro={description} />

  {
    firstLesson && (
      <section
        id="lessons"
        class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-10"
        x-data="videoPlaylist"
        data-lessons={playlistJson}
      >
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_23rem]">
          <div class="lg:sticky lg:top-20 lg:self-start" x-ref="player">
            <div class="aspect-video overflow-hidden rounded-2xl bg-primary-deep shadow-lift ring-1 ring-black/5">
              <iframe
                src={firstLesson.embedUrl}
                x-bind:src="src"
                title={`${t(lang, 'series.videos')}: ${title}`}
                class="h-full w-full"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              />
            </div>
            <div class="mt-4 flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold">
                  {t(lang, 'video.nowPlaying')}
                  ·
                  <span dir="ltr" class="inline-block" x-text="`${current + 1} / ${lessons.length}`">
                    1 / {lessons.length}
                  </span>
                </p>
                <h2
                  class="mt-1 font-sans text-xl font-semibold leading-snug"
                  dir="auto"
                  x-text="lesson?.title"
                >
                  {firstLesson.title}
                </h2>
                <p class="mt-1 text-sm text-muted-foreground" x-text="lesson?.meta">
                  {metaLine(firstLesson)}
                </p>
              </div>
              <button
                type="button"
                x-on:click="next()"
                x-show="current < lessons.length - 1"
                class="hidden shrink-0 items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-medium shadow-soft transition-colors hover:border-gold/60 hover:text-primary sm:inline-flex"
              >
                {t(lang, 'series.next')}
                <Icon name="arrow-right" class="h-4 w-4 rtl:-scale-x-100" />
              </button>
            </div>
          </div>

          <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-soft lg:self-start">
            <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-3">
              <p class="font-display text-lg leading-tight">{title}</p>
              <p class="shrink-0 text-xs text-muted-foreground tabular-nums">
                {videoCount(lang, lessons.length)}
              </p>
            </div>
            <ol x-ref="list" class="max-h-[34rem] overflow-y-auto p-2 lg:max-h-[calc(100vh-12rem)]">
              {lessons.map((lesson, index) => (
                <li data-index={index}>
                  <a
                    href={`https://www.youtube.com/watch?v=${lesson.id}`}
                    target="_blank"
                    rel="noopener"
                    x-on:click.prevent={`play(${index})`}
                    x-bind:aria-current={`current === ${index} ? 'true' : null`}
                    x-bind:class={`current === ${index} ? 'bg-accent' : 'hover:bg-secondary'`}
                    class="group flex gap-3 rounded-xl p-2 transition-colors"
                  >
                    <span class="w-5 shrink-0 pt-1 text-center text-xs font-semibold text-muted-foreground tabular-nums">
                      <span x-show={`current !== ${index}`}>{index + 1}</span>
                      <span x-show={`current === ${index}`} x-cloak class="text-primary">
                        <Icon name="play" class="mx-auto h-3 w-3 rtl:-scale-x-100" />
                      </span>
                    </span>
                    <span class="relative aspect-video w-28 shrink-0 overflow-hidden rounded-lg bg-primary-deep">
                      <img
                        src={youtubeThumbnail(lesson.id)}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        width="480"
                        height="360"
                        class="h-full w-full object-cover"
                      />
                      {lesson.minutes > 0 && (
                        <span class="absolute bottom-1 end-1 rounded bg-black/75 px-1 text-[0.65rem] font-semibold text-white tabular-nums">
                          {formatDuration(lang, lesson.minutes)}
                        </span>
                      )}
                    </span>
                    <span class="min-w-0 flex-1">
                      <span
                        class="line-clamp-2 text-sm font-medium leading-snug group-hover:text-primary"
                        dir="auto"
                      >
                        {lesson.title}
                      </span>
                      <span class="mt-1 block text-xs text-muted-foreground">
                        {t(lang, languageKeys[lesson.language])}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
            {playlistUrl && (
              <a
                href={playlistUrl}
                target="_blank"
                rel="noopener"
                class="flex items-center justify-center gap-2 border-t border-border px-4 py-3 text-sm font-medium text-primary transition-colors hover:bg-secondary"
              >
                {t(lang, 'series.playlist')}
                <Icon name="external-link" class="h-3.5 w-3.5" />
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }

  <div class="mx-auto max-w-6xl px-5 py-14">
    <article class="prose">
      <Content />
    </article>

    {(parts.length > 0 || lessons.length === 0) && (
    <section class="mt-14">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl sm:text-4xl">{t(lang, 'series.parts')}</h2>
        <div class="h-[2px] w-32 rule-gold" aria-hidden="true"></div>
      </div>

      {
        parts.length === 0 ? (
          <p class="mt-8 text-muted-foreground">{t(lang, 'series.noParts')}</p>
        ) : (
          <ol class="mt-8 divide-y divide-border overflow-hidden rounded-lg border border-border bg-card shadow-soft">
            {parts.map((part, index) => (
              <li>
                <a
                  href={articlePath(lang, entryKey(part.id))}
                  class="group flex items-start gap-5 p-5 transition-colors hover:bg-secondary/60"
                >
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 font-display text-lg text-primary">
                    {part.data.seriesPart ?? index + 1}
                  </span>
                  <span class="flex-1">
                    <span class="block text-lg leading-snug transition-colors group-hover:text-primary">
                      {part.data.title}
                    </span>
                    {part.data.excerpt && (
                      <span class="mt-1 block text-sm text-muted-foreground">
                        {part.data.excerpt}
                      </span>
                    )}
                  </span>
                  <Icon
                    name="arrow-right"
                    class="mt-3 h-4 w-4 shrink-0 text-gold rtl:-scale-x-100"
                  />
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </section>
    )}

    <a
      href={`/${lang}/series/`}
      class="mt-10 inline-flex items-center gap-2 text-sm font-medium text-primary"
    >
      <Icon name="arrow-right" class="h-4 w-4 -scale-x-100 rtl:scale-x-100" />
      {t(lang, 'series.backToSeries')}
    </a>
  </div>
</BaseLayout>
