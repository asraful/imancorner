---
import Icon from '../../../components/Icon.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SeriesCard from '../../../components/SeriesCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  entryKey,
  formatDuration,
  languageCodes,
  seriesPath,
  t,
  type Language,
} from '../../../i18n';
import {
  getHome,
  getSeries,
  getSettings,
  getTopics,
  seriesCoverId,
  seriesLabel,
  seriesMinutes,
} from '../../../lib/site';

export function getStaticPaths() {
  return languageCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;

const alternates = Object.fromEntries(
  languageCodes.map((code) => [code, `/${code}/series/`]),
);

const { data: settings } = await getSettings(lang);
const { data: home } = await getHome(lang);
const series = await getSeries(lang);
const topics = await getTopics(lang);
const topicTitles = new Map(
  topics.map((topic) => [entryKey(topic.id), topic.data.title]),
);

// Filter chips: every topic that has a series, then "Other" for the rest.
const filterKey = (topic: string) => (topicTitles.has(topic) ? topic : 'other');
const filters = topics
  .map((topic) => ({
    key: entryKey(topic.id),
    label: topic.data.title,
    icon: topic.data.icon,
    count: series.filter((entry) => entry.data.topic === entryKey(topic.id)).length,
  }))
  .filter((filter) => filter.count > 0);
const otherCount = series.filter((entry) => filterKey(entry.data.topic) === 'other').length;
if (otherCount > 0) {
  filters.push({
    key: 'other',
    label: t(lang, 'filter.other'),
    icon: 'sparkles',
    count: otherCount,
  });
}

const chipOn = 'bg-primary text-primary-foreground border-transparent';
const chipOff = 'bg-card text-foreground border-border hover:border-gold/60';
---

<BaseLayout
  lang={lang}
  title={home.seriesSection.heading || t(lang, 'series.heading')}
  description={home.seriesSection.intro || settings.tagline || t(lang, 'site.tagline')}
  alternates={alternates}
>
  <PageHeader
    eyebrow={settings.siteName}
    title={home.seriesSection.heading || t(lang, 'series.heading')}
    intro={home.seriesSection.intro}
  />

  <div class="mx-auto max-w-6xl px-5 pb-16 pt-6" x-data="{ topic: '' }">
    {
      series.length === 0 ? (
        <p class="pt-10 text-muted-foreground">{t(lang, 'series.none')}</p>
      ) : (
        <>
          {filters.length > 1 && (
            <div
              class="sticky top-16 z-30 -mx-5 mb-6 flex gap-2 overflow-x-auto bg-background/90 px-5 py-3 backdrop-blur-md [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
              role="group"
              aria-label={t(lang, 'topics.byTopic')}
            >
              <button
                type="button"
                x-on:click="topic = ''"
                x-bind:aria-pressed="(topic === '').toString()"
                x-bind:class={`topic === '' ? '${chipOn}' : '${chipOff}'`}
                aria-pressed="true"
                class:list={[
                  'inline-flex shrink-0 items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors',
                  chipOn,
                ]}
              >
                {t(lang, 'filter.all')}
                <span class="text-xs opacity-70 tabular-nums">{series.length}</span>
              </button>
              {filters.map((filter) => (
                <button
                  type="button"
                  x-on:click={`topic = ${JSON.stringify(filter.key)}`}
                  x-bind:aria-pressed={`(topic === ${JSON.stringify(filter.key)}).toString()`}
                  x-bind:class={`topic === ${JSON.stringify(filter.key)} ? '${chipOn}' : '${chipOff}'`}
                  aria-pressed="false"
                  class:list={[
                    'inline-flex shrink-0 items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors',
                    chipOff,
                  ]}
                >
                  <Icon name={filter.icon} class="h-3.5 w-3.5" />
                  {filter.label}
                  <span class="text-xs opacity-70 tabular-nums">{filter.count}</span>
                </button>
              ))}
            </div>
          )}

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {series.map((entry) => (
              <div
                x-show={`topic === '' || topic === ${JSON.stringify(filterKey(entry.data.topic))}`}
                class="flex"
              >
                <SeriesCard
                  title={entry.data.title}
                  url={seriesPath(lang, entryKey(entry.id))}
                  partsLabel={seriesLabel(entry, lang)}
                  description={entry.data.description}
                  ctaLabel={t(lang, 'series.open')}
                  coverId={seriesCoverId(entry)}
                  duration={
                    seriesMinutes(entry) > 0 ? formatDuration(lang, seriesMinutes(entry)) : ''
                  }
                  topicLabel={topicTitles.get(entry.data.topic) ?? ''}
                />
              </div>
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>
