---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLanguage, dirFor, languageCodes, t } from '../i18n';

// GitHub Pages serves this one file for every missing URL, whatever the
// language. It is rendered in the default language; the inline script below
// switches the message to the language in the requested path (/ar/…, /fi/…).
const lang = defaultLanguage;

const messages = Object.fromEntries(
  languageCodes.map((code) => [
    code,
    {
      dir: dirFor(code),
      title: t(code, 'notFound.title'),
      body: t(code, 'notFound.body'),
      home: t(code, 'notFound.home'),
    },
  ]),
);
// <-escape so the JSON can never close its own <script> tag
const messagesJson = JSON.stringify(messages).replace(/</g, '\\u003c');
---

<BaseLayout
  lang={lang}
  title={t(lang, 'notFound.title')}
  description={t(lang, 'notFound.body')}
>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center px-5 py-28 text-center"
    id="not-found"
  >
    <p class="font-display text-7xl text-gold-gradient">404</p>
    <h1 class="mt-4 text-3xl sm:text-4xl" data-msg="title">{t(lang, 'notFound.title')}</h1>
    <p class="mt-3 max-w-md text-muted-foreground" data-msg="body">
      {t(lang, 'notFound.body')}
    </p>
    <a
      href={`/${lang}/`}
      id="not-found-home"
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-emerald-gradient px-5 py-3 text-sm font-medium text-primary-foreground shadow-soft transition-transform hover:-translate-y-0.5"
    >
      <span data-msg="home">{t(lang, 'notFound.home')}</span>
      <Icon name="arrow-right" class="h-4 w-4 rtl:-scale-x-100" />
    </a>
  </div>

  <script is:inline define:vars={{ messagesJson }}>
    (function () {
      var messages = JSON.parse(messagesJson);
      var code = location.pathname.split('/')[1];
      var m = messages[code];
      if (!m || code === 'en') return;
      var root = document.getElementById('not-found');
      root.setAttribute('lang', code);
      root.setAttribute('dir', m.dir);
      root.querySelectorAll('[data-msg]').forEach(function (el) {
        el.textContent = m[el.getAttribute('data-msg')];
      });
      document.getElementById('not-found-home').href = '/' + code + '/';
      document.title = m.title;
    })();
  </script>
</BaseLayout>
