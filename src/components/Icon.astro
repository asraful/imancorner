---
/**
 * Inline line icons (Lucide geometry) so the design's iconography ships
 * without a runtime icon library. `name` values are the ones offered to
 * editors in the CMS topic form.
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;

const paths: Record<string, string> = {
  'book-open':
