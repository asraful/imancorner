---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { resolveUrl, t, type Language } from '../i18n';
import { getSettings } from '../lib/site';

interface Props {
  lang: Language;
  alternates: Partial<Record<Language, string>>;
}

const { lang, alternates } = Astro.props;

const { data: settings } = await getSettings(lang);

const navItems = settings.nav
  .filter((item) => item.label.trim() !== '')
  .map((item) => ({ label: item.label, href: resolveUrl(lang, item.url) }));

const cta =
  settings.headerCta.label.trim() === ''
    ? null
    : {
        label: settings.headerCta.label,
        href: resolveUrl(lang, settings.headerCta.url),
      };

/** A nav link is current when the page is it, or lives underneath it. */
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.startsWith('/') &&
  (path === href || (href !== `/${lang}/` && path.startsWith(href)));
---

<header
  class="sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur-md"
  x-data="{ open: false }"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href={`/${lang}/`} class="flex items-center gap-3">
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-emerald-gradient text-gold"
      >
        <Icon name="moon" class="h-4 w-4" />
      </span>
      <span class="font-display text-lg leading-none tracking-tight">
        {settings.siteName || t(lang, 'site.name')}
        {
          settings.siteKicker && (
            <span class="block font-sans text-[0.62rem] uppercase tracking-[0.28em] text-muted-foreground">
              {settings.siteKicker}
            </span>
          )
        }
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label={t(lang, 'nav.menu')}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'text-sm transition-colors hover:text-primary',
              isCurrent(item.href)
                ? 'font-medium text-primary'
                : 'text-muted-foreground',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden sm:block">
        <LanguageSwitcher lang={lang} alternates={alternates} />
      </div>

      {
        cta && (
          <a
            href={cta.href}
            class="hidden rounded-md bg-emerald-gradient px-4 py-2 text-sm font-medium text-primary-foreground shadow-soft transition-transform hover:-translate-y-0.5 lg:inline-flex"
          >
            {cta.label}
          </a>
        )
      }

      <button
        type="button"
        x-on:click="open = !open"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border text-foreground lg:hidden"
        aria-label={t(lang, 'nav.menu')}
        x-bind:aria-expanded="open.toString()"
      >
        <span x-show="!open"><Icon name="menu" class="h-4 w-4" /></span>
        <span x-show="open" x-cloak><Icon name="x" class="h-4 w-4" /></span>
      </button>
    </div>
  </div>

  <nav
    x-show="open"
    x-cloak
    class="border-t border-border bg-background px-5 py-3 lg:hidden"
    aria-label={t(lang, 'nav.menu')}
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'block py-2 text-sm',
            isCurrent(item.href)
              ? 'font-medium text-primary'
              : 'text-muted-foreground',
          ]}
        >
          {item.label}
        </a>
      ))
    }

    {
      cta && (
        <a
          href={cta.href}
          class="mt-3 inline-flex rounded-md bg-emerald-gradient px-4 py-2 text-sm font-medium text-primary-foreground shadow-soft"
        >
          {cta.label}
        </a>
      )
    }

    <div class="mt-4 border-t border-border pt-3">
      <LanguageSwitcher lang={lang} alternates={alternates} variant="full" />
    </div>
  </nav>
</header>
