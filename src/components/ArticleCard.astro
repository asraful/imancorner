---
import Icon from './Icon.astro';

interface Props {
  title: string;
  url: string;
  excerpt?: string;
  topicLabel?: string;
  topicUrl?: string;
  minutes?: number;
  minutesLabel: string;
  ctaLabel: string;
}

const {
  title,
  url,
  excerpt = '',
  topicLabel = '',
  topicUrl,
  minutes = 0,
  minutesLabel,
  ctaLabel,
} = Astro.props;
---

<article
  class="flex flex-col rounded-lg border border-border bg-card p-6 shadow-soft transition-all hover:-translate-y-1 hover:shadow-lift"
>
  <div class="flex items-center justify-between gap-3 text-xs">
    {
      topicLabel ? (
        topicUrl ? (
          <a
            href={topicUrl}
            class="rounded-full bg-accent px-3 py-1 font-medium text-accent-foreground transition-colors hover:bg-gold hover:text-gold-foreground"
          >
            {topicLabel}
          </a>
        ) : (
          <span class="rounded-full bg-accent px-3 py-1 font-medium text-accent-foreground">
            {topicLabel}
          </span>
        )
      ) : (
        <span />
      )
    }
    {
      minutes > 0 && (
        <span class="inline-flex items-center gap-1 text-muted-foreground">
          <Icon name="clock" class="h-3 w-3" /> {minutes} {minutesLabel}
        </span>
      )
    }
  </div>

  <h3 class="mt-4 text-xl leading-snug">
    <a href={url} class="transition-colors hover:text-primary">{title}</a>
  </h3>

  {
    excerpt && (
      <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
        {excerpt}
      </p>
    )
  }

  <a
    href={url}
    class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-primary"
  >
    {ctaLabel}
    <Icon name="arrow-right" class="h-4 w-4 rtl:-scale-x-100" />
  </a>
</article>
