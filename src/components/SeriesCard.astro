---
import Icon from './Icon.astro';
import { youtubeThumbnail } from '../lib/youtube';

interface Props {
  title: string;
  url: string;
  partsLabel?: string;
  description?: string;
  ctaLabel: string;
  /** YouTube id of the first lesson, shown as the cover. */
  coverId?: string;
  /** e.g. "7 h 20 min". */
  duration?: string;
  topicLabel?: string;
}

const {
  title,
  url,
  partsLabel = '',
  description = '',
  ctaLabel,
  coverId,
  duration = '',
  topicLabel = '',
} = Astro.props;
---

<article
  class="group relative flex w-full flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-gold/50 hover:shadow-lift"
>
  {
    coverId ? (
      <div class="relative aspect-video overflow-hidden bg-primary-deep">
        <img
          src={youtubeThumbnail(coverId)}
          alt=""
          loading="lazy"
          decoding="async"
          width="480"
          height="360"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-primary-deep/85 via-primary-deep/20 to-transparent"
          aria-hidden="true"
        />
        <div class="absolute inset-x-4 bottom-3 flex items-center justify-between gap-2 text-xs font-semibold text-white">
          {partsLabel && (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-black/45 px-2.5 py-1 backdrop-blur-sm">
              <Icon name="play" class="h-3 w-3" />
              {partsLabel}
            </span>
          )}
          {duration && (
            <span class="rounded-full bg-black/45 px-2.5 py-1 tabular-nums backdrop-blur-sm">
              {duration}
            </span>
          )}
        </div>
      </div>
    ) : (
      <div class="relative flex aspect-video items-end overflow-hidden bg-emerald-gradient p-4">
        <div class="pattern-lattice absolute inset-0 opacity-40" aria-hidden="true" />
        {partsLabel && (
          <span class="relative text-xs font-semibold uppercase tracking-[0.2em] text-gold">
            {partsLabel}
          </span>
        )}
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    {
      topicLabel && (
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-gold">
          {topicLabel}
        </p>
      )
    }
    <h3 class="mt-1 text-xl leading-snug">
      <a href={url} class="after:absolute after:inset-0 after:content-['']">{title}</a>
    </h3>
    {
      description && (
        <p class="mt-2 line-clamp-3 flex-1 text-sm text-muted-foreground">{description}</p>
      )
    }
    <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary">
      {ctaLabel}
      <Icon
        name="arrow-right"
        class="h-4 w-4 transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100 rtl:group-hover:-translate-x-0.5"
      />
    </span>
  </div>
</article>
